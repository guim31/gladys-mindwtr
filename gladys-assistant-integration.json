              }
            },
            {
              "value": "waiting",
              "label": {
                "en": "Waiting for",
                "fr": "En attente",
                "de": "Wartet auf",
                "es": "En espera"
              }
            },
            {
              "value": "someday",
              "label": {
                "en": "Someday/Maybe",
                "fr": "Un jour/peut-être",
                "de": "Irgendwann/Vielleicht",
                "es": "Algún día/Quizás"
              }
            }
          ]
        },
        {
          "key": "task",
          "type": "string",
          "label": {
            "en": "Task title (empty: any)",
            "fr": "Titre de la tâche (vide : toutes)",
            "de": "Titel der Aufgabe (leer: beliebig)",
            "es": "Título de la tarea (vacío: cualquiera)"
          }
        }
      ],
      "variables": [
        {
          "key": "task",
