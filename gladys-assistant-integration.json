            "fr": "Échéance sans heure",
            "de": "Fälligkeit ohne Uhrzeit",
            "es": "Vencimiento sin hora"
          }
        }
      ]
    },
    {
      "key": "inbox_review",
      "label": {
        "en": "Mindwtr inbox to review",
        "fr": "Boîte de réception Mindwtr à traiter",
        "de": "Mindwtr-Eingang durchsehen",
        "es": "Bandeja de entrada de Mindwtr por revisar"
      },
      "description": {
        "en": "An item has waited in the inbox for the delay of the configuration (GTD review).",
        "fr": "Un élément attend dans la boîte de réception depuis le délai de la configuration (revue GTD).",
        "de": "Ein Eintrag wartet seit der eingestellten Dauer im Eingang (GTD-Durchsicht).",
        "es": "Un elemento lleva en la bandeja de entrada el tiempo configurado (revisión GTD)."
      },
      "variables": [
