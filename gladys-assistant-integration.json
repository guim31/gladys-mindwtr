      "key": "task_overdue",
      "label": {
        "en": "Mindwtr task overdue",
        "fr": "Tâche Mindwtr en retard",
        "de": "Mindwtr-Aufgabe überfällig",
        "es": "Tarea de Mindwtr atrasada"
      },
      "description": {
        "en": "A task is still open when its due day ends (at midnight).",
        "fr": "Une tâche est toujours ouverte à la fin de son jour d'échéance (à minuit).",
        "de": "Eine Aufgabe ist am Ende ihres Fälligkeitstages (um Mitternacht) noch offen.",
        "es": "Una tarea sigue abierta al terminar su día de vencimiento (a medianoche)."
      },
