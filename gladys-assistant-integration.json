{
  "manifest_version": 1,
  "type": "device",
  "name": "Mindwtr",
  "description": {
    "en": "Mindwtr GTD tasks via its sync server: inbox, today's and overdue tasks, capture from a scene.",
    "fr": "Tâches GTD Mindwtr par son serveur de synchro : boîte de réception, jour, retard, ajout par scène.",
    "de": "Mindwtr-GTD-Aufgaben über den Sync-Server: Eingang, heute, überfällig, Erfassen per Szene.",
    "es": "Tareas GTD de Mindwtr vía su servidor: bandeja de entrada, hoy, atrasadas, captura por escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-mindwtr:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-mindwtr/main/cover.png",
  "categories": ["services"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Mindwtr sync server",
        "fr": "Votre serveur de synchronisation Mindwtr",
        "de": "Dein Mindwtr-Sync-Server",
        "es": "Su servidor de sincronización Mindwtr"
      },
      "description": {
        "en": "The self-hosted sync server of Mindwtr (mindwtr-cloud, Docker image). Dropbox and WebDAV sync are not supported: the integration needs this server.",
        "fr": "Le serveur de synchronisation auto-hébergé de Mindwtr (mindwtr-cloud, image Docker). Les synchros Dropbox et WebDAV ne conviennent pas : il faut ce serveur.",
        "de": "Der selbst gehostete Sync-Server von Mindwtr (mindwtr-cloud, Docker-Image). Dropbox- und WebDAV-Sync gehen nicht: Die Integration braucht diesen Server.",
        "es": "El servidor de sincronización autoalojado de Mindwtr (mindwtr-cloud, imagen Docker). La sincronización Dropbox o WebDAV no sirve: la integración necesita este servidor."
      },
      "links": [
        {
          "url": "https://github.com/dongdongbh/Mindwtr/blob/main/docker/README.md",
          "label": {
            "en": "Install the sync server",
            "fr": "Installer le serveur de synchronisation",
            "de": "Sync-Server installieren",
            "es": "Instalar el servidor de sincronización"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "The Self-Hosted URL of the app's sync settings, with :port (8787 by default) and https:// for HTTPS.",
        "fr": "L'URL « Self-Hosted » des réglages de synchronisation de l'appli, avec :port (8787 par défaut) et https:// pour le HTTPS.",
        "de": "Die Self-Hosted-URL aus den Sync-Einstellungen der App, mit :Port (standardmäßig 8787) und https:// für HTTPS.",
        "es": "La URL Self-Hosted de los ajustes de sincronización de la aplicación, con :puerto (8787 por defecto) y https:// para HTTPS."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:8787",
        "fr": "ex. http://192.168.1.20:8787",
        "de": "z. B. http://192.168.1.20:8787",
        "es": "p. ej. http://192.168.1.20:8787"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "api_token",
      "type": "secret",
      "label": {
        "en": "Sync token",
        "fr": "Jeton de synchronisation",
        "de": "Sync-Token",
        "es": "Token de sincronización"
      },
      "description": {
        "en": "The token of the app's sync settings, one of MINDWTR_CLOUD_AUTH_TOKENS of the server. Each token is its own task list.",
        "fr": "Le jeton des réglages de synchronisation de l'appli, l'un des MINDWTR_CLOUD_AUTH_TOKENS du serveur. Chaque jeton a sa propre liste de tâches.",
        "de": "Das Token aus den Sync-Einstellungen der App, eines der MINDWTR_CLOUD_AUTH_TOKENS des Servers. Jedes Token hat seine eigene Aufgabenliste.",
        "es": "El token de los ajustes de sincronización de la aplicación, uno de los MINDWTR_CLOUD_AUTH_TOKENS del servidor. Cada token tiene su propia lista de tareas."
      },
      "required": true
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "inbox_review_hours",
      "type": "select",
      "label": {
        "en": "Inbox review after",
        "fr": "Revue de la boîte de réception après",
        "de": "Eingangs-Durchsicht nach",
        "es": "Revisión de la bandeja de entrada tras"
      },
      "description": {
        "en": "The \"Inbox to review\" scene event fires when an item has waited this long in the inbox, then again at the same interval until the inbox is empty.",
        "fr": "L'événement de scène « Boîte de réception à traiter » se déclenche quand un élément y attend depuis ce délai, puis au même rythme jusqu'à ce qu'elle soit vide.",
        "de": "Das Szenen-Ereignis „Eingang durchsehen“ wird ausgelöst, wenn ein Eintrag so lange im Eingang wartet, dann im selben Abstand, bis der Eingang leer ist.",
        "es": "El evento de escena «Bandeja de entrada por revisar» se activa cuando un elemento lleva este tiempo esperando, y luego al mismo ritmo hasta que esté vacía."
      },
      "required": false,
      "default": "24",
      "options": [
        {
          "value": "4",
          "label": {
            "en": "4 hours",
            "fr": "4 heures",
            "de": "4 Stunden",
            "es": "4 horas"
          }
        },
        {
          "value": "12",
          "label": {
            "en": "12 hours",
            "fr": "12 heures",
            "de": "12 Stunden",
            "es": "12 horas"
          }
        },
        {
          "value": "24",
          "label": {
            "en": "24 hours",
            "fr": "24 heures",
            "de": "24 Stunden",
            "es": "24 horas"
          }
        },
        {
          "value": "48",
          "label": {
            "en": "48 hours",
            "fr": "48 heures",
            "de": "48 Stunden",
            "es": "48 horas"
          }
        },
        {
          "value": "72",
          "label": {
            "en": "72 hours",
            "fr": "72 heures",
            "de": "72 Stunden",
            "es": "72 horas"
          }
        },
        {
          "value": "168",
          "label": {
            "en": "1 week",
            "fr": "1 semaine",
            "de": "1 Woche",
            "es": "1 semana"
          }
        }
      ]
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For an https:// address whose certificate is self-signed (Caddy's local CA). Tick only for your own server.",
        "fr": "Pour une adresse en https:// dont le certificat est auto-signé (autorité locale de Caddy). À cocher pour votre propre serveur seulement.",
        "de": "Für eine https://-Adresse mit selbstsigniertem Zertifikat (lokale CA von Caddy). Nur für deinen eigenen Server aktivieren.",
        "es": "Para una dirección https:// con certificado autofirmado (CA local de Caddy). Márquelo solo para su propio servidor."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the server is read. Due times and midnight are always followed on time.",
        "fr": "Fréquence de lecture du serveur. Les échéances et minuit sont toujours suivis à l'heure.",
        "de": "Wie oft der Server gelesen wird. Fälligkeiten und Mitternacht werden immer pünktlich berücksichtigt.",
        "es": "Con qué frecuencia se lee el servidor. Los vencimientos y la medianoche se siguen siempre a tiempo."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when the device is added, and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout de l'appareil, et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen des Geräts und an Szenen gesendete Texte.",
        "es": "Nombres de las funciones al añadir el dispositivo y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the sync server now and reports what it finds.",
        "fr": "Lit le serveur de synchronisation maintenant et indique ce qu'il trouve.",
        "de": "Liest den Sync-Server sofort und meldet, was es findet.",
        "es": "Lee el servidor de sincronización ahora e indica lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "task_due",
      "label": {
        "en": "Mindwtr task due",
        "fr": "Tâche Mindwtr arrivée à échéance",
        "de": "Mindwtr-Aufgabe fällig",
        "es": "Tarea de Mindwtr vencida"
      },
      "description": {
        "en": "An open task reaches its due time; a due date without a time, at the start of that day.",
        "fr": "Une tâche ouverte arrive à son heure d'échéance ; une échéance sans heure, au début de ce jour-là.",
        "de": "Eine offene Aufgabe erreicht ihre Fälligkeit; eine Fälligkeit ohne Uhrzeit zu Beginn dieses Tages.",
        "es": "Una tarea abierta llega a su hora de vencimiento; un vencimiento sin hora, al empezar ese día."
      },
      "fields": [
        {
          "key": "status",
          "type": "select",
          "label": {
            "en": "GTD list (empty: any)",
            "fr": "Liste GTD (vide : toutes)",
            "de": "GTD-Liste (leer: beliebig)",
            "es": "Lista GTD (vacío: cualquiera)"
          },
          "options": [
            {
              "value": "inbox",
              "label": {
                "en": "Inbox",
                "fr": "Boîte de réception",
                "de": "Eingang",
                "es": "Bandeja de entrada"
              }
            },
            {
              "value": "next",
              "label": {
                "en": "Next actions",
                "fr": "Prochaines actions",
                "de": "Nächste Schritte",
                "es": "Próximas acciones"
              }
            },
            {
              "value": "waiting",
              "label": {
                "en": "Waiting for",
                "fr": "En attente",
                "de": "Wartet auf",
                "es": "En espera"
              }
            },
            {
              "value": "someday",
              "label": {
                "en": "Someday/Maybe",
                "fr": "Un jour/peut-être",
                "de": "Irgendwann/Vielleicht",
                "es": "Algún día/Quizás"
              }
            }
          ]
        },
        {
          "key": "task",
          "type": "string",
          "label": {
            "en": "Task title (empty: any)",
            "fr": "Titre de la tâche (vide : toutes)",
            "de": "Titel der Aufgabe (leer: beliebig)",
            "es": "Título de la tarea (vacío: cualquiera)"
          }
        }
      ],
      "variables": [
        {
          "key": "task",
          "type": "string",
          "label": {
            "en": "Task",
            "fr": "Tâche",
            "de": "Aufgabe",
            "es": "Tarea"
          }
        },
        {
          "key": "task_id",
          "type": "string",
          "label": {
            "en": "Task id",
            "fr": "Identifiant de la tâche",
            "de": "ID der Aufgabe",
            "es": "Identificador de la tarea"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "GTD list (inbox, next, waiting, someday)",
            "fr": "Liste GTD (inbox, next, waiting, someday)",
            "de": "GTD-Liste (inbox, next, waiting, someday)",
            "es": "Lista GTD (inbox, next, waiting, someday)"
          }
        },
        {
          "key": "contexts",
          "type": "string",
          "label": {
            "en": "Contexts (@home…)",
            "fr": "Contextes (@maison…)",
            "de": "Kontexte (@zuhause…)",
            "es": "Contextos (@casa…)"
          }
        },
        {
          "key": "project_name",
          "type": "string",
          "label": {
            "en": "Project",
            "fr": "Projet",
            "de": "Projekt",
            "es": "Proyecto"
          }
        },
        {
          "key": "due_date",
          "type": "string",
          "label": {
            "en": "Due date (as in Mindwtr)",
            "fr": "Échéance (telle que dans Mindwtr)",
            "de": "Fälligkeit (wie in Mindwtr)",
            "es": "Vencimiento (como en Mindwtr)"
          }
        },
        {
          "key": "all_day",
          "type": "boolean",
          "label": {
            "en": "Due date without a time",
            "fr": "Échéance sans heure",
            "de": "Fälligkeit ohne Uhrzeit",
            "es": "Vencimiento sin hora"
          }
        }
      ]
    },
